__pycache__/
*.pyc
*.pyo
.vs/
.vscode/
*.log
.pytest_cache/
.claude/*
!.claude/skills/
!.claude/skills/**

# Token cifrado colocado a mao ao lado do loader (por PC) - o blob em si
# nao e legivel sem a senha, mas nao ha motivo para versionar copias locais.
token_cifrado.dat

# Benchmark: saidas REGERAVEIS de uma rodada (runner.py --run). O que fica
# versionado e' o dado durável - input.json, reference.json, metadata.json,
# e as MEDICOES (score.json, baseline.json, reference_score.json). O
# resultado bruto do solver e a lista completa de achados sao grandes
# (12MB e 3MB no projeto piloto) e voltam identicos rodando o benchmark de
# novo.
nuvem/benchmark/projects/*/result.json
nuvem/benchmark/projects/*/findings.json
nuvem/benchmark/projects/*/comparison.json
nuvem/benchmark/projects/*/reference_findings.json

# Etapa 2B.1 - mesma regra de cima, para os artefatos novos:
# `scoped_comparison.json` é irmão de `comparison.json` (5 MB, sai idêntico
# rodando `runner.py --run <id> --scoped`).
nuvem/benchmark/projects/*/scoped_comparison.json

# A rodada PROVISÓRIA da Etapa 2B fica preservada para auditoria, mas só o
# que não se regenera: `README.txt`, `score.json` e o `input.json` daquela
# rodada. O resultado bruto e os achados (17 MB somados) voltam idênticos
# refazendo o caminho descrito no README.
nuvem/benchmark/projects/*/provisional_2b/result.json
nuvem/benchmark/projects/*/provisional_2b/findings.json
nuvem/benchmark/projects/*/provisional_2b/comparison.json

# AI Team: estado de execucao de cada run. E' volumoso e regeneravel; o
# workflow sobe o diretorio como artifact do GitHub Actions. O que fica
# versionado e' a arquitetura, o codigo e as baselines.
.ai-team/runs/
.ai-team/metrics.json
